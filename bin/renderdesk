#!/usr/bin/env python3
"""render-desk: drop a .blend in Drive, get a finished mp4 back."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from renderdesk import config, providers, watch  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="renderdesk")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("watch", help="watch the drop folder forever (what launchd runs)")
    sub.add_parser("once", help="handle whatever is in the drop folder, then exit")
    sub.add_parser("doctor", help="check the setup without rendering anything")
    serve = sub.add_parser("serve", help="the web page the editor uses, plus the watcher")
    serve.add_argument("--no-watcher", action="store_true")
    sub.add_parser("password", help="set the editor's password")
    cost = sub.add_parser("cost", help="what rendering has actually cost, and the monthly projection")
    cost.add_argument("--clips", type=int, default=25)
    cost.add_argument("--seconds", type=int, default=35)
    cost.add_argument("--fps", type=int, default=30)
    render = sub.add_parser("render", help="render one file directly, bypassing the folders")
    render.add_argument("blend")
    render.add_argument("--provider", default="")
    args = ap.parse_args()

    cfg = config.load()
    if args.cmd == "doctor":
        return watch.doctor(cfg)
    if args.cmd == "password":
        import re
        import secrets

        words = secrets.token_urlsafe(12)
        path = config.ENV_PATH
        path.parent.mkdir(parents=True, exist_ok=True)
        text = path.read_text() if path.exists() else ""
        if re.search(r"^EDITOR_PASSWORD=.*$", text, re.M):
            text = re.sub(r"^EDITOR_PASSWORD=.*$", f"EDITOR_PASSWORD={words}", text, flags=re.M)
        else:
            text += f"\nEDITOR_PASSWORD={words}\n"
        path.write_text(text)
        path.chmod(0o600)
        print("Password set. Send this to your editor, then delete the message:\n")
        print(f"    {words}\n")
        print("Anyone signed in already stays signed in. To cut everyone off, delete")
        print(f"{Path(cfg['STATE_DIR']) / 'session.key'} and run this again.")
        return 0
    if args.cmd == "serve":
        from renderdesk import web

        web.serve(cfg, with_watcher=not args.no_watcher)
        return 0
    if args.cmd == "cost":
        from renderdesk import ledger

        out = ledger.summary(cfg, args.clips, args.seconds, args.fps)
        if not out:
            print("Nothing measured yet. Render one real clip on the GPU and this will")
            print("tell you the monthly bill for your whole batch.")
            return 0
        print(f"  measured over {out['jobs']} GPU job(s), {out['frames']} frames")
        print(f"  {out['seconds_per_frame']} seconds per frame while rendering")
        print(f"  {out['overhead_seconds']}s per job renting and starting a machine")
        print(f"  ${out['usd_per_hour']:.2f} per hour paid on average")
        print(f"  ${out['usd_so_far']:.2f} spent so far")
        print()
        print(f"  {out['plan']} = {out['planned_frames']} frames")
        print(f"  ${out['usd_per_clip']:.2f} per clip")
        print(f"  projected: ${out['projected_usd']:.2f} per month")
        if out["thin"]:
            print()
            print("  Careful: this is measured on very few frames, so the per-frame")
            print("  number is rough. Render one real clip before trusting it.")
        return 0
    if args.cmd == "watch":
        watch.loop(cfg)
        return 0
    if args.cmd == "once":
        watch.loop(cfg, once=True)
        return 0
    if args.cmd == "render":
        if args.provider:
            cfg["PROVIDER"] = args.provider
        dirs = watch.ensure_folders(cfg)
        source = Path(args.blend).resolve()
        staged = dirs[0] / source.name
        if staged != source:
            import shutil

            shutil.copy2(source, staged)
        watch.run_one(staged, cfg, dirs, providers.get(cfg["PROVIDER"], cfg))
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
